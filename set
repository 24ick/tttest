<script>
(function(){
  const raw = document.getElementById('dataStore').textContent;
  const DATA = JSON.parse(raw);

  document.getElementById('footCount').textContent = DATA.length.toLocaleString();

  const sheetCounts = {};
  DATA.forEach(r => { sheetCounts[r.sheet] = (sheetCounts[r.sheet]||0) + 1; });
  const sheetNames = Object.keys(sheetCounts).sort();

  const filterChipsEl = document.getElementById('filterChips');
  const filterPanel = document.getElementById('filterPanel');
  const filterToggleBtn = document.getElementById('filterToggleBtn');
  const filterCountLabel = document.getElementById('filterCountLabel');
  const filterClearBtn = document.getElementById('filterClearBtn');
  let activeSheets = new Set();

  function updateFilterToggleLabel(){
    if (activeSheets.size === 0) {
      filterToggleBtn.textContent = '種類で絞り込み ▾';
      filterToggleBtn.classList.remove('active');
      filterCountLabel.textContent = '全シート対象';
    } else {
      filterToggleBtn.textContent = `絞り込み中 (${activeSheets.size}) ▾`;
      filterToggleBtn.classList.add('active');
      filterCountLabel.textContent = `${activeSheets.size}件のシートを選択中`;
    }
  }

  function renderChips(){
    filterChipsEl.innerHTML = '';
    sheetNames.forEach(name => {
      const chip = document.createElement('div');
      chip.className = 'chip' + (activeSheets.has(name) ? ' active' : '');
      chip.textContent = `${name} (${sheetCounts[name]})`;
      chip.addEventListener('click', () => {
        if (activeSheets.has(name)) activeSheets.delete(name);
        else activeSheets.add(name);
        renderChips();
        updateFilterToggleLabel();
        runSearch();
      });
      filterChipsEl.appendChild(chip);
    });
  }
  renderChips();
  updateFilterToggleLabel();

  filterToggleBtn.addEventListener('click', () => {
    filterPanel.classList.toggle('open');
  });
  filterClearBtn.addEventListener('click', () => {
    activeSheets.clear();
    renderChips();
    updateFilterToggleLabel();
    runSearch();
  });

  const input = document.getElementById('searchInput');
  const resultsEl = document.getElementById('results');
  const hintEl = document.getElementById('hintText');
  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const clearBtn = document.getElementById('clearBtn');

  let currentResults = [];
  let shown = 0;
  const PAGE = 40;

  function escapeHtml(s){
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function highlight(text, query){
    if (!query) return escapeHtml(text);
    const idx = text.indexOf(query);
    if (idx === -1) return escapeHtml(text);
    return escapeHtml(text.slice(0,idx)) + '<mark>' + escapeHtml(text.slice(idx, idx+query.length)) + '</mark>' + escapeHtml(text.slice(idx+query.length));
  }

  function cardHtml(r, query){
    const qHtml = highlight(r.question || '(問題文なし)', query);
    const subHtml = r.sub ? `<div class="sub-text">${highlight(r.sub, query)}</div>` : '';
    const ansHtml = `<div class="ans-block"><span class="ans-label">答え</span><div class="ans-text">${highlight(r.answer, query)}</div></div>`;
    const catTag = r.category ? `<span class="tag cat">${escapeHtml(r.category)}</span>` : '';
    return `<div class="result-card">
      <div class="meta-row">
        <div><span class="tag">${escapeHtml(r.sheet)}</span> ${catTag}</div>
        <span class="idx">#${r.id}</span>
      </div>
      <div class="q-text">${qHtml}</div>
      ${subHtml}
      ${ansHtml}
    </div>`;
  }

  function search(query){
    const q = query.trim();
    let pool = DATA;
    if (activeSheets.size > 0) {
      pool = pool.filter(r => activeSheets.has(r.sheet));
    }
    if (!q) return [];
    const starts = [];
    const contains = [];
    const ansOnly = [];
    for (const r of pool) {
      const qt = r.question || '';
      const st = r.sub || '';
      if (qt.startsWith(q) || st.startsWith(q)) {
        starts.push(r);
      } else if (qt.includes(q) || st.includes(q)) {
        contains.push(r);
      } else if ((r.answer || '').includes(q) || (r.category||'').includes(q)) {
        ansOnly.push(r);
      }
    }
    return starts.concat(contains, ansOnly);
  }

  function renderResults(){
    resultsEl.innerHTML = '';
    const slice = currentResults.slice(0, shown);
    if (slice.length === 0) {
      const q = input.value.trim();
      resultsEl.innerHTML = `<div class="empty-state">
        <div class="big">${q ? '一致する問題が見つかりませんでした' : 'キーワードを入力してください'}</div>
        <div>${q ? '別のキーワードや、問題文のもう少し先の部分で試してください' : '問題文の冒頭の数文字を入れると検索できます'}</div>
      </div>`;
      loadMoreBtn.style.display = 'none';
      return;
    }
    const frag = document.createDocumentFragment();
    const query = input.value.trim();
    const div = document.createElement('div');
    div.innerHTML = slice.map(r => cardHtml(r, query)).join('');
    while (div.firstChild) frag.appendChild(div.firstChild);
    resultsEl.appendChild(frag);
    loadMoreBtn.style.display = (shown < currentResults.length) ? 'block' : 'none';
  }

  function runSearch(){
    currentResults = search(input.value);
    shown = Math.min(PAGE, currentResults.length);
    hintEl.textContent = input.value.trim()
      ? `${currentResults.length.toLocaleString()} 件ヒット`
      : `全${DATA.length.toLocaleString()}問収録`;
    renderResults();
  }

  let debounceTimer;
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runSearch, 120);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    input.focus();
    runSearch();
  });

  loadMoreBtn.addEventListener('click', () => {
    shown = Math.min(shown + PAGE, currentResults.length);
    renderResults();
  });

  runSearch();
})();
</script>
</body>
</html>
